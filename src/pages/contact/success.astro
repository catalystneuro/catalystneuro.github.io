---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { SITE } from "../../consts";
---
<Base title="Inquiry Sent" description="Your project inquiry has been sent to the CatalystNeuro team." noindex>
  <section class="success">
    <div class="container-x success-inner">
      <div class="success-mark"><Icon name="check" size={30} /></div>
      <h1>Your inquiry has been sent</h1>
      <p>Thank you for the details. We typically respond within 1–2 business days. If you would like to talk sooner, you can book a free 30-minute call now.</p>
      <div class="success-actions">
        <a href="/consultation/" class="btn btn-primary">Book a call <Icon name="arrow" size={15} /></a>
        <a href="/nwb-conversions/" class="btn btn-ghost">See conversion work</a>
      </div>
      <p class="success-alt">Nothing arrived, or something to add? Write to <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
    </div>
  </section>
</Base>

<style>
  .success { min-height: 60vh; display: grid; place-items: center; text-align: center; }
  .success-inner { max-width: 34rem; }
  .success-mark { width: 4.5rem; height: 4.5rem; border-radius: 50%; background: color-mix(in srgb, #16a34a 14%, white); color: #15803d; display: grid; place-items: center; margin: 0 auto 1.5rem; }
  .success h1 { font-size: clamp(1.8rem, 4vw, 2.5rem); }
  .success p { color: var(--color-ink-muted); margin: 1rem 0 2rem; font-size: 1.1rem; line-height: 1.6; }
  .success-actions { display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; }
  .success .success-alt { font-size: 0.92rem; margin: 2rem 0 0; }
  .success-alt a { color: var(--color-blue); font-weight: 500; }
</style>
